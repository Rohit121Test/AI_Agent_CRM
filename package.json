
{
  "devDependencies": {
    "@faker-js/faker": "^10.1.0",
    "cypress": "^15.6.0",
    "cypress-iframe": "^1.0.1",
    "cypress-mochawesome-reporter": "^4.0.2",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.3",
    "mochawesome-report-generator": "^6.0.1"
  },
  "scripts": {
    "cy:run": "cypress run",
    "cy:open": "cypress open",
    "report:merge": "mochawesome-merge cypress/reports/html/.jsons/*.json > cypress/reports/report.json",
    "report:generate": "marge cypress/reports/report.json -f report -o cypress/reports",
    "report:all": "npm run report:merge && npm run report:generate"
  }
}